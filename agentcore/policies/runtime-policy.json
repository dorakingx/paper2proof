{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunManagedCodeInterpreterSessions",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:StartCodeInterpreterSession",
        "bedrock-agentcore:InvokeCodeInterpreter",
        "bedrock-agentcore:GetCodeInterpreterSession",
        "bedrock-agentcore:StopCodeInterpreterSession"
      ],
      "Resource": "arn:aws:bedrock-agentcore:us-west-2:aws:code-interpreter/aws.codeinterpreter.v1"
    },
    {
      "Sid": "PersistJobState",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:TransactWriteItems"
      ],
      "Resource": "arn:aws:dynamodb:us-west-2:291877508281:table/paper2proof-jobs"
    },
    {
      "Sid": "ArchiveImmutableEvidence",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::paper2proof-evidence-291877508281-us-west-2/evidence/*"
    }
  ]
}
